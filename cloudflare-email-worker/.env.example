# Local dev only — copy to .dev.vars and fill in. NEVER commit .dev.vars.
# Production values are set with: npx wrangler secret put BACKEND_WEBHOOK_SECRET

# Where the Worker forwards parsed emails (your Supabase Edge Function URL).
BACKEND_WEBHOOK_URL=http://localhost:9999/webhook

# Shared secret, sent as `Authorization: Bearer <secret>`.
# Generate one with: openssl rand -hex 32
BACKEND_WEBHOOK_SECRET=local-test-secret-change-me
